    "step": {
      "init": {
        "title": "Record to NAS (SMB)",
        "description": "The camera only speaks **SMB1** (NT LM 0.12) — the server needs `server min protocol = NT1`. Recordings go to `<share>\\\\xiaomi_camera_videos\\\\<MAC>`.",
