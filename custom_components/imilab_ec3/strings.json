          "smb_addr": "SMB server IP address",
          "smb_name": "Server NetBIOS name",
          "smb_dir": "Share (e.g. cameras or cameras\\\\imilab)",
          "smb_group": "Workgroup / domain",
          "smb_user": "User",
          "smb_pass": "Password",
          "smb_sync_interval": "Sync",
          "smb_retention": "Keep recordings",
          "smb_enable": "Enable recording to NAS"
        }
      }
    },
    "error": {
      "smb_failed": "The camera could not connect to the share: {error}",
      "smb_no_server": "Enter the SMB server address"
    }
  },
